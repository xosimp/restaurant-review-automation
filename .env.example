# Cavnar AI — local environment. Copy to `.env` (gitignored) beside
# hosted_dashboard.py and fill in what you need. Every variable the code
# reads, with its default and purpose, is in docs/ops/ENVIRONMENT.md.
#
# A local backend with production's keys sends real email and texts if its
# scheduler runs — leave ALLOW_LOCAL_SCHEDULER unset (CLAUDE.md).

# ── The app ────────────────────────────────────────────────────────────────
# Signs sessions and links. Any long random string locally; without one the
# app mints a throwaway key and every restart signs everyone out.
SECRET_KEY=
# Fernet key for stored credentials:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_KEY=
# Where emailed links point. Locally your own address (or an ngrok tunnel).
BASE_URL=http://localhost:5050

# ── Models (empty = every AI path uses its offline fallback) ──────────────
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# ── Email (empty = nothing is sent) ───────────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=
WILL_EMAIL=

# ── Google (optional) ─────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=
GOOGLE_SSO_CLIENT_ID=
GOOGLE_SSO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Texts, push, billing, contracts (optional; production only) ───────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_PRIVATE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# DOCUSIGN_INTEGRATION_KEY=
