{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hosted-dashboard",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "hosted_dashboard.py"
      ],
      "port": 5000,
      "autoPort": true
    },
    {
      "name": "marketing-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8787",
        "--directory",
        "public"
      ],
      "port": 8787
    }
  ]
}
